// /api/news.js
// Pulls the latest headlines from NJPW's own official RSS feed —
// title, link, and date only, never the article body — so the
// frontend can link straight out to the original source instead
// of reproducing anyone's work.

const FEEDS = [
  { source: "NJPW Global", url: "https://news.njpw1972.com/feed" },
];

const MAX_ITEMS = 6;

function decodeEntities(str) {
  return str
    .replace(/&amp;/g, "&")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'");
}

function extractTag(xml, tag) {
  const match = xml.match(new RegExp(`<${tag}[^>]*>([\\s\\S]*?)</${tag}>`, "i"));
  if (!match) return "";
  return decodeEntities(
    match[1].replace(/^\s*<!\[CDATA\[([\s\S]*?)\]\]>\s*$/, "$1").trim()
  );
}

function parseItems(xml, source) {
  const items = [...xml.matchAll(/<item[^>]*>([\s\S]*?)<\/item>/gi)];
  return items.slice(0, MAX_ITEMS).map((m) => {
    const block = m[1];
    return {
      source,
      title: extractTag(block, "title"),
      link: extractTag(block, "link"),
      pubDate: extractTag(block, "pubDate"),
    };
  });
}

export default async function handler(req, res) {
  try {
    const results = await Promise.all(
      FEEDS.map(async ({ source, url }) => {
        const r = await fetch(url, {
          headers: { "User-Agent": "DojoToDome/1.0 (NJPW fan hub; news aggregator linking to original sources)" },
        });
        if (!r.ok) return [];
        const xml = await r.text();
        return parseItems(xml, source);
      })
    );

    const merged = results
      .flat()
      .sort((a, b) => new Date(b.pubDate) - new Date(a.pubDate))
      .slice(0, MAX_ITEMS);

    res.setHeader("Cache-Control", "s-maxage=1800, stale-while-revalidate=3600");
    return res.status(200).json(merged);
  } catch (err) {
    console.error(err);
    return res.status(500).json({ error: "Could not load news feed" });
  }
}
